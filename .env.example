NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-music-marketplace
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Development only. Production rejects disabled authentication.
AUTH_MODE=disabled
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Required Discogs application credentials. Use a descriptive contact in the User-Agent.
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=agent-tool-server-music-marketplace/0.1.0 (contact@example.com)
DISCOGS_API_BASE_URL=https://api.discogs.com
DISCOGS_TIMEOUT_MS=10000
DISCOGS_MAX_RETRIES=2
DISCOGS_RATE_LIMIT_MAX=60

# Caching defaults off until Discogs approves retention for the deployment.
DISCOGS_CACHE_TTL_MS=0
DISCOGS_SEARCH_CACHE_TTL_MS=0
DISCOGS_CACHE_MAX_ENTRIES=500

# Keep disabled until Discogs approves hosted redistribution.
DISCOGS_MARKETPLACE_STATS_ENABLED=false
DISCOGS_MARKETPLACE_LISTINGS_ENABLED=false
